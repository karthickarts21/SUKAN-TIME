{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "SalarySettingsDoc": {
      "title": "SalarySettingsDoc",
      "description": "User specific salary and attendance settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "basicSalary": { "type": "number" },
        "dailyDutyHours": { "type": "string" },
        "weeklyOff": { "type": "string" },
        "overtimeMultiplier": { "type": "number" },
        "defaultPf": { "type": "number" },
        "defaultEsi": { "type": "number" },
        "defaultAdvance": { "type": "number" },
        "defaultOtherDeduction": { "type": "number" },
        "bankTransferAmount": { "type": "number" },
        "bankTransferMode": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "basicSalary", "dailyDutyHours", "weeklyOff"]
    },
    "MonthDataDoc": {
      "title": "MonthDataDoc",
      "description": "Monthly attendance, daily time records, incentives, and salary data",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "monthName": { "type": "string" },
        "date": { "type": "string" },
        "sections": { "type": "array" },
        "dailyEntries": { "type": "object" },
        "manualHolidays": { "type": "array" },
        "billCount": { "type": "number" },
        "salaryData": { "type": "object" },
        "lastSavedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "monthName", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Authenticated user profile"
    },
    "/users/{userId}/settings/salary": {
      "schema": "SalarySettingsDoc",
      "description": "User specific salary settings"
    },
    "/users/{userId}/months/{monthName}": {
      "schema": "MonthDataDoc",
      "description": "Monthly time records and attendance logs"
    }
  }
}
